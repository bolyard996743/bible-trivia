# Public project URL. Safe to share. The anon key is not a secret service key,
# but it still should not be committed with a real value from your dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://wmopoyxwghddtkbmrfyy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only API.Bible key for NKJV text. Do not prefix with NEXT_PUBLIC_.
# Set this in Vercel for Production and Preview. Leave it empty here.
API_BIBLE_KEY=

# Server-only secret that seals the shared scripture chapter cache.
# Use a long random string. Set it in Vercel for Production and Preview.
# Do not prefix it with NEXT_PUBLIC_.
SCRIPTURE_CACHE_KEY=

# Server-only Supabase secret key. It writes the shared scripture cache.
# The anon key cannot read that table, and the browser never sees this key.
# Set it in Vercel for Production and Preview. Do not prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
